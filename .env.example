# Server & Database Configuration
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/peri_tracker

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-for-port-vehicle-tracker-2026-production
JWT_EXPIRES_IN=7d
COOKIE_NAME=peri_session

# Map & Real-time Configuration
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_PORT_NAME=Hambantota International Port (HIPG)
NEXT_PUBLIC_DEFAULT_LAT=6.1205
NEXT_PUBLIC_DEFAULT_LNG=81.1180

# GPS Ingestion & Policy Settings
GPS_MIN_ACCURACY_METERS=50
GPS_MAX_SPEED_KMH=120
GPS_STALE_THRESHOLD_SECONDS=60
GPS_OFFLINE_THRESHOLD_SECONDS=180
GPS_INTERRUPTED_THRESHOLD_SECONDS=90
GEOFENCE_HYSTERESIS_COUNT=2

